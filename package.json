{
  "name": "homeflow",
  "productName": "HomeFlow",
  "version": "0.1.0",
  "description": "HomeFlow – έσοδα και έξοδα του σπιτιού",
  "main": "main.js",
  "author": "demelistasos",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gr.demelistasos.homeflow",
    "productName": "HomeFlow",
    "files": [
      "main.js",
      "xlsx.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "HomeFlow-Windows-${version}.${ext}",
      "extraFiles": [
        {
          "from": "build/ΔΙΑΒΑΣΕ ΜΕ.txt",
          "to": "ΔΙΑΒΑΣΕ ΜΕ.txt"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "artifactName": "HomeFlow-Mac-${version}.${ext}"
    }
  }
}
