{
  "name": "homeflow",
  "productName": "HomeFlow",
  "version": "0.1.0",
  "description": "HomeFlow – έσοδα και έξοδα του σπιτιού",
  "main": "main.js",
  "author": "demelistasos",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gr.demelistasos.homeflow",
    "productName": "HomeFlow",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "HomeFlow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HomeFlow",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "demelistasos",
        "repo": "HomeFlow",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "artifactName": "HomeFlow-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "HomeFlow"
    }
  }
}
